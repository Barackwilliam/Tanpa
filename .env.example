# Copy to your hosting panel's environment variables (never commit real values)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=tanpa.co.tz,www.tanpa.co.tz
DJANGO_CSRF_TRUSTED_ORIGINS=https://tanpa.co.tz,https://www.tanpa.co.tz
SITE_URL=https://tanpa.co.tz
DJANGO_SERVE_MEDIA=true

# PostgreSQL (optional; SQLite is used when POSTGRES_DB is empty)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost

# Email (password resets + receipts)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.tanpa.co.tz
EMAIL_PORT=587
EMAIL_HOST_USER=info@tanpa.co.tz
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TANPA <info@tanpa.co.tz>

# Payments
PAYMENT_SANDBOX=false
AZAMPAY_ENABLED=false
AZAMPAY_LIVE=false
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_API_KEY=
# Random string; set the callback URL in the AzamPay portal to
# https://tanpa.co.tz/callbacks/azampay/<this token>/
AZAMPAY_CALLBACK_TOKEN=
