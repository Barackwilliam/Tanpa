# Copy to .env for local use, or set these in your hosting panel. Never commit real values.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=tanpa.co.tz,www.tanpa.co.tz
DJANGO_CSRF_TRUSTED_ORIGINS=https://tanpa.co.tz,https://www.tanpa.co.tz
SITE_URL=https://tanpa.co.tz

# --- Supabase Postgres -------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string -> URI (Session pooler)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase Storage (all images & uploads) ---------------------------------
# Supabase -> Project Settings -> API: Project URL + service_role key (server only!)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Create in Supabase -> Storage. Make tanpa-media PUBLIC, keep tanpa-private PRIVATE.
SUPABASE_PUBLIC_BUCKET=tanpa-media
SUPABASE_PRIVATE_BUCKET=tanpa-private

# --- Email (password resets + receipts) --------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TANPA <info@tanpa.co.tz>

# --- Payments ------------------------------------------------------------------
PAYMENT_SANDBOX=false
AZAMPAY_ENABLED=false
AZAMPAY_LIVE=false
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_API_KEY=
# Random string; callback URL in the AzamPay portal: https://tanpa.co.tz/callbacks/azampay/<token>/
AZAMPAY_CALLBACK_TOKEN=
